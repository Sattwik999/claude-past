  "homepage": "https://github.com/Sattwik999/claude-past#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sattwik999/claude-past.git"
  },
  "bugs": {
    "url": "https://github.com/Sattwik999/claude-past/issues"
  },
